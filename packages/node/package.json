{
  "name": "@credo-ts/node",
  "exports": {
    ".": {
      "cli": "./build/index.mjs",
      "import": "./src/index.ts"
    },
    "./express": {
      "cli": "./build/express/index.mjs",
      "import": "./src/express/index.ts"
    }
  },
  "version": "0.7.1",
  "files": [
    "build"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "types": "./build/index.d.mts",
    "module": "./build/index.mjs",
    "exports": {
      ".": "./build/index.mjs",
      "./express": {
        "types": "./build/express/index.d.mts",
        "import": "./build/express/index.mjs",
        "require": "./build/express/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "homepage": "https://github.com/openwallet-foundation/credo-ts/tree/main/packages/node",
  "repository": {
    "type": "git",
    "url": "https://github.com/openwallet-foundation/credo-ts",
    "directory": "packages/node"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@credo-ts/core": "workspace:*",
    "@credo-ts/didcomm": "workspace:*",
    "@types/node": "catalog:",
    "@types/express": "catalog:",
    "@types/ws": "catalog:",
    "express": "catalog:",
    "hpke": "catalog:",
    "rxjs": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "nock": "catalog:",
    "typescript": "catalog:"
  }
}
